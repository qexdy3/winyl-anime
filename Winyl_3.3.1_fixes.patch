+void SkinDraw::ResetPress()
+{
+	pressElement = nullptr;
+
+	for (std::size_t i = 0, isize = layouts.size(); i < isize; ++i)
+	{
+		for (std::size_t j = 0, jsize = layouts[i]->elements.size(); j < jsize; ++j)
+		{
+			SkinElement* element = layouts[i]->elements[j]->element.get();
+
+			// A button can stay pressed forever if its WM_LBUTTONUP was lost
+			// (the window lost the mouse capture, was minimized, a modal dialog
+			// appeared, etc.). Such a stale element would consume the next click.
+			if (element->IsPress())
+			{
+				element->isPress = false;
+
+				if (!element->IsHidden() && element->IsRedrawPress())
+					RedrawElement(element);
+			}
+		}
+	}
+}
