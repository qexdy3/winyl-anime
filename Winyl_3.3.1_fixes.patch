+void SkinList::ScrollWindowStep(int dy)
+{
+	if (imageBack.IsValid() && (backStretch || backCover || backContain))
+	{
+		// The wallpaper is anchored to the viewport. ScrollWindowEx would shift
+		// the already painted pixels and make the image drift, so repaint the
+		// whole control and let OnPaint draw both nodes and background again.
+		::InvalidateRect(thisWnd, NULL, FALSE);
+	}
+	else
+	{
+		::ScrollWindowEx(thisWnd, 0, dy, NULL, NULL, NULL, NULL, SW_INVALIDATE);
+	}
+
+	::UpdateWindow(thisWnd);
+}
